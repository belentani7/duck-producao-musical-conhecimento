+.form-heading span:last-child { color: var(--muted-dark); }
+.brief-form label { display: grid; gap: 8px; margin-bottom: 20px; color: var(--muted); font-family: var(--mono); font-size: 9px; letter-spacing: .11em; text-transform: uppercase; }
+.brief-form input, .brief-form select, .brief-form textarea { width: 100%; padding: 12px 0; border: 0; border-bottom: 1px solid var(--line-soft); outline: 0; background: transparent; color: var(--paper); font-family: var(--body); font-size: 14px; letter-spacing: normal; text-transform: none; transition: border-color 160ms ease; }
+.brief-form input::placeholder, .brief-form textarea::placeholder { color: var(--muted-dark); }
+.brief-form select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--lime) 50%), linear-gradient(135deg, var(--lime) 50%, transparent 50%); background-position: calc(100% - 7px) 50%, calc(100% - 2px) 50%; background-repeat: no-repeat; background-size: 5px 5px, 5px 5px; }
+.brief-form option { background: var(--panel); color: var(--paper); }
+.brief-form textarea { resize: vertical; }
+.brief-form input:focus, .brief-form select:focus, .brief-form textarea:focus { border-color: var(--lime); }
+.form-note { margin: 16px 0 0; color: var(--muted-dark); font-family: var(--mono); font-size: 8px; line-height: 1.55; }
+
+.site-footer { display: grid; grid-template-columns: 1fr 1fr 1.2fr; gap: 24px; align-items: end; width: min(1200px, 86vw); margin: 0 auto; padding: 30px 0 42px; border-top: 1px solid var(--line-soft); }
+.footer-brand { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-size: 20px; font-weight: 800; letter-spacing: -.06em; }
+.footer-brand img { width: 31px; height: 31px; object-fit: contain; }
+.footer-signal { margin-left: 6px; color: var(--lime); opacity: .75; }
+.footer-note, .footer-meta { color: var(--muted-dark); font-family: var(--mono); font-size: 9px; line-height: 1.5; letter-spacing: .09em; text-transform: uppercase; }
+.footer-meta { display: flex; align-items: center; justify-content: flex-end; gap: 24px; }
+.footer-meta button { display: grid; width: 36px; height: 36px; place-items: center; border: 1px solid var(--line); background: transparent; color: var(--lime); transform: rotate(-45deg); transition: background 160ms ease, color 160ms ease; }
+.footer-meta button:hover { background: var(--lime); color: var(--ink); }
+
+@media (min-width: 1100px) {
+  .site-nav:has(+ .hero-section) { background: linear-gradient(to bottom, rgba(8,13,10,.58), rgba(8,13,10,0)); }
+}
+@media (max-width: 900px) {
+  .desktop-nav, .brand-caption { display: none; }
+  .menu-trigger { display: grid; }
+  .site-nav.is-open { background: rgba(8,13,10,.97); }
+  .mobile-nav { display: grid; grid-template-columns: 1fr; gap: 4px; width: min(90vw, 480px); margin: 0 auto; padding: 14px 0 26px; }
+  .mobile-nav button, .mobile-nav a { display: flex; align-items: center; gap: 14px; width: 100%; padding: 13px 0; border-bottom: 1px solid var(--line-soft); text-align: left; }
+  .mobile-nav button span { color: var(--lime); }
+  .mobile-nav button svg, .mobile-nav a svg:last-child { margin-left: auto; }
+  .mobile-nav a { border-bottom: 0; color: var(--lime); }
+  .hero-shell { grid-template-columns: 1fr; align-content: end; min-height: 860px; padding-bottom: 115px; }
+  .hero-aside { display: flex; align-items: end; gap: 26px; padding-top: 0; }
+  .hero-status { display: none; }
+  .hero-scene-switcher { display: flex; gap: 20px; padding: 0; }
+  .hero-scene-switcher button { grid-template-columns: 20px 28px; gap: 7px; padding: 0; }
+  .hero-scene-switcher button span:last-child { display: none; }
+  .hero-coordinate { margin-left: auto; padding: 0; border: 0; }
+  .metrics-strip { grid-template-columns: repeat(2, 1fr); }
+  .metric:nth-child(2) { border-right: 0; }.metric--note { border-top: 1px solid var(--line-soft); }.metric:nth-child(3) { border-top: 1px solid var(--line-soft); }
+  .story-grid, .studio-grid, .contact-grid { gap: 50px; }
+  .services-grid { grid-template-columns: repeat(2, 1fr); }
+  .site-footer { grid-template-columns: 1fr 1fr; }.footer-meta { grid-column: 1 / -1; justify-content: space-between; }
+}
+@media (max-width: 600px) {
+  .nav-shell { min-height: 70px; }
+  .hero-shell { width: 88vw; min-height: 800px; padding-top: 110px; }
+  .hero-copy h1 { font-size: clamp(54px, 17vw, 90px); }
+  .hero-lede { margin-top: 25px; font-size: 14px; }
+  .hero-actions { display: grid; grid-template-columns: 1fr; }
+  .button { width: 100%; }
+  .hero-footer { right: 6vw; bottom: 23px; left: 6vw; font-size: 8px; }.hero-microcopy { display: none; }
+  .hero-aside { display: block; }.hero-coordinate { display: none; }
+  .metrics-strip { grid-template-columns: repeat(2, 1fr); }.metric { min-height: 104px; padding: 18px; }.metric strong { font-size: 33px; }.metric > span { font-size: 8px; }.metric--note { grid-column: 1 / -1; min-height: 86px; }
+  .section-shell { width: 86vw; padding: 100px 0; }.section-marker { margin-bottom: 52px; }.story-grid, .studio-grid, .contact-grid { grid-template-columns: 1fr; gap: 42px; }.story-title-block h2, .services-intro h2, .catalogue-heading h2, .studio-copy h2, .contact-heading h2 { font-size: clamp(50px, 15vw, 80px); }
+  .story-image-wrap { margin-top: 70px; }.image-caption { right: -3px; }.story-copy .large-copy { font-size: 18px; }
+  .services-intro, .catalogue-heading { display: block; margin-bottom: 45px; }.services-intro p { margin: 28px 0 0; }.catalogue-heading .text-link { margin-top: 27px; }.services-grid { grid-template-columns: 1fr; }.service-card { min-height: 260px; }
+  .catalogue-section { width: 100%; padding-right: 7vw; padding-left: 7vw; }.release-row { grid-template-columns: 25px 44px minmax(0,1fr) 20px; gap: 12px; min-height: 80px; }.release-cover { width: 44px; height: 44px; }.release-meta { display: none; }.release-title { font-size: 16px; }.release-row:hover { padding: 0 8px; }
+  .studio-facts { gap: 9px; }.studio-facts strong { font-size: 15px; }.studio-facts small { font-size: 7px; }
+  .brief-form { padding: 21px; }.site-footer { width: 86vw; grid-template-columns: 1fr; gap: 24px; }.footer-meta { display: grid; grid-template-columns: 1fr auto; gap: 10px; }.footer-meta span:nth-child(2) { grid-column: 1; grid-row: 2; }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; }
+}
